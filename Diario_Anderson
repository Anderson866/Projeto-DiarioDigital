import tkinter as tk
from tkinter import messagebox, scrolledtext
from datetime import datetime
import os

ARQUIVO = "diario.txt"

def salvar_anotacao():
    texto = entrada_texto.get("1.0", tk.END).strip()
    if texto:
        data_hora = datetime.now().strftime("%d/%m/%Y %H:%M:%S")
        try:
            with open(ARQUIVO, "a", encoding="utf-8") as f:
                f.write(f"[{data_hora}]\n{texto}\n\n")
            entrada_texto.delete("1.0", tk.END)
            messagebox.showinfo("Salvo!", "Anotação salva com sucesso!")
        except Exception as e:
            messagebox.showerror("Erro", f"Falha ao salvar: {str(e)}")
    else:
        messagebox.showwarning("Aviso", "Digite uma anotação antes de salvar!")

def mostrar_anotacoes():
    try:
        if not os.path.exists(ARQUIVO):
            messagebox.showinfo("Diário", "Nenhuma anotação encontrada.")
            return
        
        with open(ARQUIVO, "r", encoding="utf-8") as f:
            conteudo = f.read()
        
        janela = tk.Toplevel(root)
        janela.title("Diário Completo")
        txt_area = scrolledtext.ScrolledText(janela, width=70, height=25)
        txt_area.pack(padx=10, pady=10)
        txt_area.insert(tk.END, conteudo)
        txt_area.config(state=tk.DISABLED)
        
    except Exception as e:
        messagebox.showerror("Erro", f"Falha ao ler arquivo: {str(e)}")

def buscar_anotacoes():
    def realizar_busca():
        termo = entrada_busca.get().lower()
        if not termo:
            messagebox.showwarning("Aviso", "Digite um termo para busca!")
            return
        
        try:
            with open(ARQUIVO, "r", encoding="utf-8") as f:
                linhas = f.readlines()
            
            resultados = []
            for i in range(0, len(linhas), 3):
                if termo in linhas[i].lower() or termo in linhas[i+1].lower():
                    resultados.extend(linhas[i:i+2])
            
            janela_resultados = tk.Toplevel(janela_busca)
            txt_area = scrolledtext.ScrolledText(janela_resultados, width=60, height=15)
            txt_area.pack(padx=10, pady=10)
            txt_area.insert(tk.END, "".join(resultados))
            txt_area.config(state=tk.DISABLED)
            
        except Exception as e:
            messagebox.showerror("Erro", f"Falha na busca: {str(e)}")

    janela_busca = tk.Toplevel(root)
    janela_busca.title("Buscar Anotações")
    
    tk.Label(janela_busca, text="Digite o termo de busca:").pack(pady=5)
    entrada_busca = tk.Entry(janela_busca, width=40)
    entrada_busca.pack(pady=5)
    
    tk.Button(janela_busca, text="Buscar", command=realizar_busca).pack(pady=5)

def criar_interface():
    global root, entrada_texto
    
    root = tk.Tk()
    root.title("Diário Pessoal")
    root.geometry("600x400")
    
    # Área de texto principal
    tk.Label(root, text="Nova Anotação:", font=('Arial', 12)).pack(pady=5)
    entrada_texto = scrolledtext.ScrolledText(root, width=70, height=15)
    entrada_texto.pack(padx=10, pady=5)
    
    # Frame para botões
    botoes = tk.Frame(root)
    botoes.pack(pady=10)
    
    tk.Button(botoes, text="Salvar", command=salvar_anotacao, width=15).pack(side=tk.LEFT, padx=5)
    tk.Button(botoes, text="Ver Todas", command=mostrar_anotacoes, width=15).pack(side=tk.LEFT, padx=5)
    tk.Button(botoes, text="Buscar", command=buscar_anotacoes, width=15).pack(side=tk.LEFT, padx=5)
    
    root.mainloop()

if __name__ == "__main__":
    criar_interface()
